<?xml version="1.0" encoding="utf-8"?>
<!--
    Bahasa Melayu.

    The detectors in this app are Malaysia-specific — MyKad numbers, 01X/03
    phone formats, the 1-300 and 1-800 service-line filter, Malay enumerator
    words in the IPv4 guard — while the interface was English only. This is the
    other half of that.

    app_name is carried over unchanged rather than left out: it is the product
    name, and declaring it keeps lint's MissingTranslation honest about the rest.
-->
<resources>
    <string name="app_name">Card Pro</string>
    <string name="action_redact">Tapis</string>

    <!-- ── Skrin utama ─────────────────────────────────────────────────────── -->
