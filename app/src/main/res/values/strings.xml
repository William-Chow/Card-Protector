    <string name="reveal_last_n">Keeping last %1$d</string>
    <string name="reveal_first_n">Keeping first %1$d</string>

    <!-- ── Mask glyph picker ───────────────────────────────────────────────── -->
    <string name="masked">Masked by</string>
    <string name="mask_with">Mask with %1$s</string>
    <!-- Spoken names for MASK_SYMBOLS, in the same order. A chip whose whole
         label is "•" or "^" is announced as "bullet" or as nothing at all. -->
    <string-array name="mask_symbol_names">
        <item>asterisk</item>
        <item>bullet</item>
        <item>hash</item>
        <item>letter x</item>
        <item>dollar sign</item>
        <item>exclamation mark</item>
        <item>at sign</item>
        <item>percent sign</item>
        <item>caret</item>
        <item>ampersand</item>
    </string-array>

    <!-- ── The card hero ───────────────────────────────────────────────────── -->
    <string name="hero_footer_masked">Masked on this device</string>
    <!-- Baked into the shared PNG by renderCardBitmap. -->
    <string name="image_footer">Masked on device · Card Pro</string>
    <string name="hero_footer_empty">Your masked card appears here</string>
    <string name="hero_valid">✓ valid</string>
    <!-- The hero draws its number one character at a time so kept digits can be
         tinted, which leaves a screen reader reciting "asterisk" sixteen times.
         These three compose one sentence for it instead; each wraps the one
         before, so a translator can reorder within each without losing a part. -->
    <string name="hero_a11y">%1$s card, %2$s</string>
    <string name="hero_a11y_showing">%1$s, showing %2$s</string>
    <string name="hero_a11y_valid">%1$s, checksum valid</string>
    <plurals name="digits_hidden">
        <item quantity="one">%1$d digit hidden</item>
        <item quantity="other">%1$d digits hidden</item>
    </plurals>

    <!-- ── Overflow menu ───────────────────────────────────────────────────── -->
    <string name="theme_menu">Theme, currently %1$s</string>
    <string name="theme_system">System</string>
    <string name="theme_light">Light</string>
    <string name="theme_dark">Dark</string>
    <string name="privacy_options">Privacy options</string>

    <!-- ── The PROCESS_TEXT sheet ──────────────────────────────────────────── -->
