    <!-- ── The Reveal control ──────────────────────────────────────────────── -->
    <!-- Scoped on purpose: the slider only ever governs card numbers. -->
    <string name="reveal_title">Reveal — card numbers only</string>
    <string name="reveal_subtitle">Other types use fixed safe defaults.</string>
    <string name="mode_last">Last</string>
    <string name="mode_first">First</string>
    <string name="mode_first6_last4">6 + 4</string>
    <string name="reveal_first6_last4">Showing first 6 + last 4</string>
